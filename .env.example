# ── MongoDB Atlas ──────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true
MONGODB_DB_NAME=cardsense

# ── Google Gemini ──────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here


# ── Frontend (Vite) ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
