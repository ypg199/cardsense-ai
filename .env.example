# ── MongoDB Atlas ──────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true
MONGODB_DB_NAME=cardsense

# ── Google Gemini ──────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here


# ── Frontend (Vite) ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Security & limits ─────────────────────────────────────────────────
# Shared secret for POST /crawl and GET /crawl/jobs (send as X-Admin-Key).
# Leave empty to disable the admin endpoints.
ADMIN_API_KEY=
MAX_UPLOAD_MB=10
MAX_FILES_PER_REQUEST=12
# Sessions (statement text and transactions) are deleted after this many hours
SESSION_TTL_HOURS=24
# Extra CORS origins for a deployed frontend, comma-separated
ALLOWED_ORIGINS=
